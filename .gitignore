.DS_Store
Thumbs.db

# --- Plugin packaging (do not ship in wp-radius-seo.zip) ---
# Excluded from `git archive` via .gitattributes (`export-ignore`): .cursor/** .github/**
# Also listed in .distignore for wp-cli style builds.
# Do NOT gitignore .github/ here — issue templates must stay tracked on the default branch.

# Cursor — track project rules only; ignore other local Cursor data (never shipped — see .gitattributes)
.cursor/*
!.cursor/rules/
!.cursor/rules/**
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-*

# Dependencies / build (root only — assets/vendor may ship bundled JS)
/node_modules/
/vendor/
composer.lock

# WordPress / local
*.log
wp-config-local.php
.env
.env.*

# Archives / temp
*.zip
*.tar.gz

# PHPUnit / coverage
phpunit.xml
.phpunit.result.cache
coverage/

