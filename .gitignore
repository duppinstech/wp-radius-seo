# OS / editor
.DS_Store
Thumbs.db

# --- Plugin packaging (do not ship in wp-radius-seo.zip) ---
# Excluded from `git archive` via .gitattributes (`export-ignore`): .cursor/** .github/** .claude/** workflows/** CLAUDE.md AGENTS.md .mcp.json INTENT.md PLAN.md
# Also listed in .distignore for wp-cli style builds.
# Do NOT gitignore .github/ or the shared Claude files here — they stay on the default branch.
# Personal Claude overrides are gitignored below.

# Cursor — track project rules only; ignore other local Cursor data (never shipped — see .gitattributes)
.cursor/*
!.cursor/rules/
!.cursor/rules/**

# Claude Code — personal overrides only. Shared files under .claude/ stay tracked.
CLAUDE.local.md
.claude/settings.local.json
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-*

# Dependencies / build (root only — assets/vendor may ship bundled JS)
/node_modules/
/vendor/
composer.lock

# WordPress / local
*.log
wp-config-local.php
.env
.env.*

# Legacy Magic Page plugin reference — local reference only, never distributed
/magic-page/

# Archives / temp
*.zip
*.tar.gz

# PHPUnit / coverage
phpunit.xml
.phpunit.result.cache
coverage/

# Language POT (optional: commit if you ship translations)
# languages/*.pot
